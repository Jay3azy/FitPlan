@layouts.app({ title: 'Nueva alergia' })
  @page({ title: 'Nueva alergia' })
    <div class="sidebar-layout">
      @include('partials/admin_sidebar')

      <div class="sidebar-layout__content">
        <div class="panel" style="max-width: 560px;">
          @form({ route: 'admin.allergies.store', method: 'POST' })
            <div class="form-grid">
              @field.root({ name: 'code' })
                @!field.label({ text: 'Código' })
                @!input.control({ type: 'text', placeholder: 'GLUTEN', maxlength: 20 })
                @!field.error()
              @end
              @field.root({ name: 'name' })
                @!field.label({ text: 'Nombre' })
                @!input.control({ type: 'text', placeholder: 'Gluten' })
                @!field.error()
              @end

              <div class="form-grid--full">
                @field.root({ name: 'description' })
                  @!field.label({ text: 'Descripción (opcional)' })
                  @!textarea.control({ placeholder: 'Presente en trigo, cebada y centeno...', rows: '3' })
                  @!field.error()
                @end
              </div>
            </div>

            <div class="form-actions">
              @!button({ text: 'Crear alergia', type: 'submit', variant: 'primary' })
              @link({ route: 'admin.allergies.index', class: 'btn btn--secondary' })
                Cancelar
              @end
            </div>
          @end
        </div>
      </div>
    </div>
  @end
@end
