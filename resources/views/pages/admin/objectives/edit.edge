@layouts.app({ title: 'Editar objetivo' })
  @page({ title: `Editar · ${objective.name}` })
    <div class="sidebar-layout">
      @include('partials/admin_sidebar')

      <div class="sidebar-layout__content">
        <div class="panel" style="max-width: 560px;">
          @form({ route: 'admin.objectives.update', routeParams: { id: objective.id }, method: 'PUT' })
            <div class="form-grid">
              @field.root({ name: 'code' })
                @!field.label({ text: 'Código' })
                @!input.control({ type: 'text', value: objective.code, maxlength: 20 })
                @!field.error()
              @end
              @field.root({ name: 'name' })
                @!field.label({ text: 'Nombre' })
                @!input.control({ type: 'text', value: objective.name })
                @!field.error()
              @end

              @field.root({ name: 'calorieAdjustmentFactor' })
                @!field.label({ text: 'Factor de ajuste calórico' })
                @!input.control({ type: 'number', step: '0.01', min: '0.1', max: '3', value: objective.calorieAdjustmentFactor })
                @!field.error()
              @end
              @field.root({ name: 'proteinFactorPerKg' })
                @!field.label({ text: 'Proteína (g por kg de peso)' })
                @!input.control({ type: 'number', step: '0.1', min: '0.1', max: '10', value: objective.proteinFactorPerKg })
                @!field.error()
              @end

              <div class="form-grid--full">
                @field.root({ name: 'description' })
                  @!field.label({ text: 'Descripción (opcional)' })
                  @!textarea.control({ value: objective.description, rows: '3' })
                  @!field.error()
                @end
              </div>
            </div>

            <div class="form-actions">
              @!button({ text: 'Guardar cambios', type: 'submit', variant: 'primary' })
              @link({ route: 'admin.objectives.index', class: 'btn btn--secondary' })
                Cancelar
              @end
            </div>
          @end
        </div>
      </div>
    </div>
  @end
@end
