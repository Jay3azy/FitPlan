@layouts.app({ title: 'Nuevo objetivo' })
  @page({ title: 'Nuevo objetivo' })
    <div class="sidebar-layout">
      @include('partials/admin_sidebar')

      <div class="sidebar-layout__content">
        <div class="panel" style="max-width: 560px;">
          @form({ route: 'admin.objectives.store', method: 'POST' })
            <div class="form-grid">
              @field.root({ name: 'code' })
                @!field.label({ text: 'Código' })
                @!input.control({ type: 'text', placeholder: 'BAJAR_PESO', maxlength: 20 })
                @!field.error()
              @end
              @field.root({ name: 'name' })
                @!field.label({ text: 'Nombre' })
                @!input.control({ type: 'text', placeholder: 'Bajar de peso' })
                @!field.error()
              @end

              @field.root({ name: 'calorieAdjustmentFactor' })
                @!field.label({ text: 'Factor de ajuste calórico' })
                @!input.control({ type: 'number', step: '0.01', min: '0.1', max: '3', placeholder: '0.8' })
                @!field.error()
              @end
              @field.root({ name: 'proteinFactorPerKg' })
                @!field.label({ text: 'Proteína (g por kg de peso)' })
                @!input.control({ type: 'number', step: '0.1', min: '0.1', max: '10', placeholder: '1.8' })
                @!field.error()
              @end

              <div class="form-grid--full">
                @field.root({ name: 'description' })
                  @!field.label({ text: 'Descripción (opcional)' })
                  @!textarea.control({ placeholder: 'Déficit calórico controlado...', rows: '3' })
                  @!field.error()
                @end
              </div>
            </div>

            <div class="form-actions">
              @!button({ text: 'Crear objetivo', type: 'submit', variant: 'primary' })
              @link({ route: 'admin.objectives.index', class: 'btn btn--secondary' })
                Cancelar
              @end
            </div>
          @end
        </div>
      </div>
    </div>
  @end
@end
