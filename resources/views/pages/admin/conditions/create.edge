@layouts.app({ title: 'Nueva condición' })
  @page({ title: 'Nueva condición médica' })
    <div class="sidebar-layout">
      @include('partials/admin_sidebar')

      <div class="sidebar-layout__content">
        <div class="panel" style="max-width: 560px;">
          @form({ route: 'admin.conditions.store', method: 'POST' })
            <div class="form-grid">
              @field.root({ name: 'code' })
                @!field.label({ text: 'Código' })
                @!input.control({ type: 'text', placeholder: 'HIPERTENSION', maxlength: 20 })
                @!field.error()
              @end
              @field.root({ name: 'name' })
                @!field.label({ text: 'Nombre' })
                @!input.control({ type: 'text', placeholder: 'Hipertensión' })
                @!field.error()
              @end

              @field.root({ name: 'maxSodiumMg' })
                @!field.label({ text: 'Tope de sodio diario (mg, opcional)' })
                @!input.control({ type: 'number', step: '1', min: '0', placeholder: '1500' })
                @!field.error()
              @end
              @field.root({ name: 'maxPurinesMg' })
                @!field.label({ text: 'Tope de purinas diario (mg, opcional)' })
                @!input.control({ type: 'number', step: '1', min: '0', placeholder: '400' })
                @!field.error()
              @end

              <div class="form-grid--full">
                @field.root({ name: 'description' })
                  @!field.label({ text: 'Descripción (opcional)' })
                  @!textarea.control({ placeholder: 'Limita el sodio diario permitido...', rows: '3' })
                  @!field.error()
                @end
              </div>
            </div>

            <div class="form-actions">
              @!button({ text: 'Crear condición', type: 'submit', variant: 'primary' })
              @link({ route: 'admin.conditions.index', class: 'btn btn--secondary' })
                Cancelar
              @end
            </div>
          @end
        </div>
      </div>
    </div>
  @end
@end
